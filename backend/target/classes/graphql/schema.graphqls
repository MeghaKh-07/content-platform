type User {
    id: ID!
    name: String!
    email: String!
    posts: [Post!]!
}

type Post {
    id: ID!
    title: String!
    content: String!
    createdAt: String!
    author: User!
    comments: [Comment!]!
}

type Comment {
    id: ID!
    text: String!
    createdAt: String!
    author: User!
}

type Query {
    "Paginated list of posts, most recent first"
    posts(limit: Int = 10, offset: Int = 0): [Post!]!
    post(id: ID!): Post
    users: [User!]!
    user(id: ID!): User
}

type Mutation {
    createUser(name: String!, email: String!): User!
    createPost(title: String!, content: String!, authorId: ID!): Post!
    addComment(postId: ID!, text: String!, authorId: ID!): Comment!
}
